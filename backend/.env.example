# ============================================================
#  LeaveDesk — Environment Variables
#  Copy this file:  cp .env.example .env
#  Then edit .env with your MySQL password
# ============================================================

PORT=5000
NODE_ENV=development

# MySQL — only change DB_PASSWORD
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=leavedesk

# JWT Secret — keep this as-is or change to any long string
JWT_SECRET=leavedesk_jwt_secret_key_2025_do_not_share
JWT_EXPIRES_IN=7d

# Frontend URL (no trailing slash)
FRONTEND_URL=http://localhost:3000
